{
  "name": "combly-mcp",
  "version": "1.0.0",
  "description": "MCP connector for Combly: load, search and export YouTube, TikTok and Instagram comments and draw fair giveaway winners.",
  "type": "module",
  "bin": {
    "combly-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . combly.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://commentexport.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commentexport/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/commentexport/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "combly",
    "youtube-comments",
    "instagram-giveaway",
    "tiktok-comments",
    "comment-export"
  ],
  "mcpName": "io.github.commentexport/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
